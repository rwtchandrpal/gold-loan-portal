# =============================================================================
# Gold Loan Portal — Unified Environment Configuration
# =============================================================================
#
# USAGE GUIDELINES:
# 1. Local Development: Copy this file to `.env` in the monorepo root:
#      cp .env.example .env
#    The root `.env` is the single canonical local configuration file loaded by
#    both the backend server and frontend Vite client.
#
# 2. Render (Backend Web Service): Configure these variables in Render Dashboard
#    (Environment tab). Do NOT commit `.env` or production credentials to Git.
#
# 3. Vercel (Frontend Project): Configure `VITE_API_BASE_URL` in Vercel Project
#    Settings (Environment Variables). Client builds receive ONLY variables
#    with the `VITE_` prefix; backend secrets are never bundled into client code.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
# Local default: 4000. In Render, PORT is automatically injected by the platform.
PORT=4000
NODE_ENV=development

# CORS Configuration: Allowed frontend origins (comma-separated if multiple).
# Local default: http://localhost:5173
# Production (Render): Set to your Vercel deployment URL (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Option A: Local PostgreSQL (Native on Windows or Docker Compose)
# For local development, DIRECT_URL is optional (falls back to DATABASE_URL)
DATABASE_URL=postgresql://goldloan_dev:your_password@localhost:5432/gold_loan_portal?schema=public

# Option B: Neon PostgreSQL (Production Cloud Deployment)
# 1. DATABASE_URL: Pooled connection string (PgBouncer) used by the running API
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# 2. DIRECT_URL: Direct unpooled connection string (port 5432) required for Prisma migrations
# DIRECT_URL=postgresql://neondb_owner:your_password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. Financial Constants
# -----------------------------------------------------------------------------
# Benchmark gold rate in INR per gram of 24K gold (server-authoritative)
GOLD_RATE_24K=7000

# -----------------------------------------------------------------------------
# 4. AI Configuration (Google Gemini API — Server Side Only)
# -----------------------------------------------------------------------------
# Never expose GEMINI_API_KEY to the frontend client. Read strictly server-side.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Local default: http://localhost:4000 (points to the local Express server)
# Production (Vercel): Set to your deployed Render API URL (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:4000
