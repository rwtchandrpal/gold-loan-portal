# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option A: Local PostgreSQL (Native on Windows or Docker Compose)
# For local development, DIRECT_URL is optional (falls back to DATABASE_URL)
DATABASE_URL=postgresql://goldloan_dev:your_password@localhost:5432/gold_loan_portal?schema=public

# Option B: Neon PostgreSQL (Serverless / Production Deployment)
# 1. DATABASE_URL: Pooled connection string (PgBouncer) used by runtime app
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# 2. DIRECT_URL: Direct unpooled connection string (port 5432) required for Prisma migrations
# DIRECT_URL=postgresql://neondb_owner:your_password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Financial Constants
GOLD_RATE_24K=7000

# AI Configuration (Gemini API - Server Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
