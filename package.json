{
  "name": "gldportal",
  "version": "1.0.0",
  "private": true,
  "description": "Gold Loan Portal with Gemini AI Loan Assist Agent",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "db:verify": "npm run db:verify --workspace=server",
    "eval": "npm run eval --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
